FROM python:3.10 AS builder
WORKDIR /build

COPY requirements.txt requirements-train.txt ./

RUN pip install --no-cache-dir --target=/build/deps -r requirements.txt

RUN pip install --no-cache-dir -r requirements.txt -r requirements-train.txt

COPY generate_dataset.py train_model.py ./
RUN python generate_dataset.py \
 && python train_model.py

FROM python:3.10-slim
WORKDIR /app

COPY --from=builder /build/deps /usr/local/lib/python3.10/site-packages
COPY --from=builder /build/model.joblib ./model.joblib
COPY app.py ./

ENV MODEL_PATH=/app/model.joblib
EXPOSE 8000
CMD ["python", "-m", "uvicorn", "app:app", "--host", "0.0.0.0", "--port", "8000"]
